[Unit]
Description=AI Stock Research Web (Next.js)
After=network-online.target ai-stock-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-stock/apps/web
Environment=NODE_ENV=production
ExecStart=/usr/bin/pnpm start --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
