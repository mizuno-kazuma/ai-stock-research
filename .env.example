# ===== データソース =====
JQUANTS_API_KEY=
JQUANTS_PLAN=light
# free | light（現行運用は light。free は12週遅延）
EDINET_SUBSCRIPTION_KEY=
FRED_API_KEY=
EDGAR_USER_AGENT=Your Name (your-email@example.com)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TDNET_ENABLED=false

# ===== LLM =====
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LITELLM_LOG_LEVEL=WARNING
LLM_KILL_SWITCH=false

# ===== ストレージ =====
# WSL2 ホーム配下。/mnt/c は禁止（docs/15-windows-runtime.md §6）
# Windows ネイティブ: DATA_DIR=%USERPROFILE%\ai-stock\data
# 未指定なら OS のホーム配下 ai-stock/data を使う。
# 空文字を入れると DuckDB がリポジトリ直下を開こうとして失敗する。未指定なら data_dir から導出。
# DATA_DIR=/home/user/ai-stock/data
# WAREHOUSE_PATH=
# VECTOR_DIR=
# BACKUP_DIR=/home/user/ai-stock/backups

# ===== アプリ =====
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
AUTH_MODE=none
API_TOKEN=
CORS_ORIGINS=http://localhost:3000
TZ=Asia/Tokyo
PYTHONUTF8=1
APP_VERSION=0.1.0

# ===== コスト上限 =====
LLM_DAILY_CAP_USD=1.0
LLM_MONTHLY_CAP_USD=20.0

# ===== 通知 =====
NOTIFY_WEBHOOK_URL=
NOTIFY_ENABLED=true

# ===== 運用 =====
LOG_LEVEL=INFO
SENTRY_DSN=


# ===== Phase B（クラウド） =====
# local | cloud（cloud のとき AUTH_MODE=none は起動時に拒否）
DEPLOYMENT_PROFILE=local
# Neon / Supabase の接続文字列。未設定なら DATA_DIR 配下の SQLite。
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
# VECTOR_STORE_BACKEND=lancedb | pgvector | memory
VECTOR_STORE_BACKEND=lancedb
# Cloudflare R2（未設定ならローカル Volume / DATA_DIR）
# WAREHOUSE_URI=s3://your-bucket/warehouse
# BLOB_URI=s3://your-bucket/blobs
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# Web（Vercel）: NEXT_PUBLIC_API_BASE_URL=https://<api>.fly.dev/api/v1
#               NEXT_PUBLIC_API_TOKEN=<same as API_TOKEN>
