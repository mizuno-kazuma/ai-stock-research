# ===== データソース =====
JQUANTS_API_KEY=
JQUANTS_PLAN=free
EDINET_SUBSCRIPTION_KEY=
FRED_API_KEY=
EDGAR_USER_AGENT=Your Name (your-email@example.com)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TDNET_ENABLED=false

# ===== LLM =====
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LITELLM_LOG_LEVEL=WARNING
LLM_KILL_SWITCH=false

# ===== ストレージ =====
# WSL2 ホーム配下。/mnt/c は禁止（docs/15-windows-runtime.md §6）
# Windows ネイティブ: DATA_DIR=%USERPROFILE%\ai-stock\data
# 未指定なら OS のホーム配下 ai-stock/data を使う。
# DATA_DIR=/home/user/ai-stock/data
WAREHOUSE_PATH=
VECTOR_DIR=
# BACKUP_DIR=/home/user/ai-stock/backups

# ===== アプリ =====
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
AUTH_MODE=none
API_TOKEN=
CORS_ORIGINS=http://localhost:3000
TZ=Asia/Tokyo
PYTHONUTF8=1
APP_VERSION=0.1.0

# ===== コスト上限 =====
LLM_DAILY_CAP_USD=1.0
LLM_MONTHLY_CAP_USD=20.0

# ===== 通知 =====
NOTIFY_WEBHOOK_URL=
NOTIFY_ENABLED=true

# ===== 運用 =====
LOG_LEVEL=INFO
SENTRY_DSN=
